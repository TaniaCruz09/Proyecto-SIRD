# ============================================
# SIRD Backend — Variables de entorno
# Copia este archivo a ".env" y completa los valores.
# ============================================

# Conexión local (PostgreSQL)
HOST=localhost
PORT=5003
DATA_BASE_NAME=sird
DATA_BASE_PORT=5432
DATA_BASE_USER=postgres
DATA_BASE_PASSWORD=123
MIGRATIONS_TABLE_NAME=migrations

# En producción usa la cadena completa de conexión (ej. Neon/Supabase).
# Si defines DATABASE_URL, se ignora HOST/DATA_BASE_*.
# DATABASE_URL=postgresql://usuario:password@host:5432/sird

# Seguridad
API_KEY=tu_api_key
JWT_SECRET=esta-es-la-clave

# Correo (recuperación de contraseña / notificaciones)
GMAIL_USER=tu_correo@gmail.com
GMAIL_PASS=tu_app_password

# TypeORM: true crea los esquemas y tablas automáticamente (SOLO desarrollo)
# Con false, usa las migraciones: npm run migration:run
DB_SYNC=true

# Opcional: esquemas adicionales a crear al iniciar, separados por coma.
# Los esquemas de las entidades ya se detectan automáticamente.
# DB_SCHEMAS=catalogos,otro_esquema

# CORS: orígenes permitidos separados por coma
# Ej: CORS_ORIGIN=http://localhost:3000,https://tu-app.vercel.app
# Incluye la IP de LAN para que otras PC de la red puedan usar el frontend.
CORS_ORIGIN=http://localhost:3000,http://192.168.1.xxx:3000

# Carpeta única para los archivos subidos (fuera del proyecto).
# Si es relativa se interpreta respecto a Backend/; nunca respecto al CWD.
UPLOADS_DIR=/escribir/rutaDeAlmcenamiento/Documents/SIRD/archivos
